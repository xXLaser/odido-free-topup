# Bearer-Token (Zugangscode) — siehe ANLEITUNG.md
# Holen mit: https://github.com/GuusBackup/Odido.Authenticator/releases/latest
ODIDO_TOKEN=hier_dein_token_einfuegen

# Handynummer der SIM im Router (ohne Leerzeichen)
ODIDO_MSISDN=+31612345678

# Auffüllen erst wenn Rest darunter liegt (in MB).
# Odido erlaubt den nächsten Aanvuller oft erst bei wenig Rest (~350).
ODIDO_THRESHOLD=350

# Prüfintervall in Sekunden (120 = alle 2 Minuten)
ODIDO_INTERVAL=120
