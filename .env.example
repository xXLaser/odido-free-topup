# === Variante A: Odido-App-Token (API) ===
ODIDO_TOKEN=hier_dein_token_einfuegen
ODIDO_MSISDN=+31612345678
ODIDO_THRESHOLD=350
ODIDO_INTERVAL=120

# === Variante B: ZTE-Router + SMS (EMPFOHLEN wenn Token nicht klappt) ===
# Router-Adresse im Browser (oft 192.168.0.1 oder 192.168.1.1)
ZTE_HOST=192.168.0.1
# Leer lassen (MC888 Login ohne Benutzername)
ZTE_USER=
# Admin-/Website-Passwort vom Aufkleber — NICHT das WLAN-Passwort
ZTE_PASSWORD=WebsitePasswortVomAufkleber

# Posteingang pruefen alle N Sekunden
ZTE_INTERVAL=120

# Optional: alle N Minuten EXTRA an 1280 senden (0 = aus, nur bei Odido-SMS)
# Nur einschalten wenn du aktiv viel downloadest. Beispiel: 45
ZTE_PERIODIC_EXTRA_MINUTES=0
